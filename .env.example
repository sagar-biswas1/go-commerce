# --- Service -----------------------------------------------------------------
VERSION=1.0.0
SERVICE_NAME=go-commerce
HTTP_PORT=8080
# development | staging | production.
# Anything other than "development" marks the refresh cookie Secure, so it is
# never sent over plain HTTP.
ENVIRONMENT=development

# --- JWT ---------------------------------------------------------------------
# Two DIFFERENT keys, at least 32 characters each. Sharing one would let a
# refresh token verify as an access token, turning a long-lived credential into
# a session that never expires.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
JWT_REFRESH_SECRET=change-me-too-and-make-it-different-again

# Optional. Tokens are rejected unless their issuer and audience match these, so
# a token minted by another service that happens to share a secret is refused.
# Default to the service name.
# JWT_ISSUER=go-commerce
# JWT_AUDIENCE=go-commerce-api

# Optional lifetimes, as Go durations.
# Keep the access TTL short: it is the window in which a revoked session still
# works, because access tokens are checked by signature alone.
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h
# JWT_LEEWAY=30s

# --- Postgres ----------------------------------------------------------------
PGHOST=localhost
PGDATABASE=go_commerce
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=disable

# --- First administrator -----------------------------------------------------
# Used only when the users table contains no admin. Registration always creates
# an ordinary user and creating a privileged one requires being one, so without
# this a fresh database has no first move.
# Remove the password from the environment once the account exists.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=Change-me-1
